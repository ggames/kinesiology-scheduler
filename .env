# DB_TYPE: 'postgres' | 'better-sqlite3' | 'sqljs'
# Se utiliza 'better-sqlite3' para desarrollo local sin servidor PostgreSQL externo.
# Cambiar a 'postgres' cuando el servicio PostgreSQL esté activo en el puerto 5432.
DB_TYPE=better-sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_USER=ggames
DB_PASS=GGames9573
DB_DATABASE=kinesiology
JWT_SECRET=super-secret-key-change-me

# URL del servidor backend (usada para generar enlaces de activación de cuenta)
APP_URL=http://localhost:3000

# Orígenes permitidos para CORS (REST y WebSocket).
# Separar con comas para múltiples orígenes.
# Puerto 8081: Expo / React Native web (metro bundler)
# Puerto 4200: Angular
# Puerto 3001: React / Vite
FRONTEND_URL=http://localhost:8081,http://localhost:4200,http://localhost:3001,http://localhost:5173

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000